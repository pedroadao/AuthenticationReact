# Imagem de desenvolvimento: roda o servidor do Vite com hot-reload.
# Código-fonte e node_modules são montados via volume pelo docker-compose
# (ver ../Authentication/docker-compose.yml), então não há COPY de código aqui.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

CMD ["npm", "run", "dev"]
